# PostgreSQL — adapter selon votre environnement (Docker, Azure, Supabase, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextgen_education?schema=public"

# Secrets JWT — À CHANGER en production (générer avec `openssl rand -hex 64`)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Azure Blob Storage — photos et documents (bulletins PDF, certificats...).
# Chaîne de connexion trouvable dans Azure Portal > votre compte de stockage
# > Sécurité + réseau > Clés d'accès.
AZURE_STORAGE_CONNECTION_STRING=""

# Mot de passe par défaut des comptes créés par le script de seed
SEED_DEFAULT_PASSWORD="ChangeMoi123!"
